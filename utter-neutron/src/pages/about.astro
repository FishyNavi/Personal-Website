---
import BasedLayout from '../layouts/basedLayout.astro'
import ContentBox from "../components/contentBox.astro";

const pageTitle = "Aboutme"
---

<BasedLayout pageTitle = {pageTitle}>
    <div class="page">
        <ContentBox>
            <div class="yap">
                <h2>Welcome!</h2>
                <p>Hello. This is a website i made for myself, so i can practice coding a bit. You can't find me in many social media so i guess it will also be a place of my own, away from other stuff, online.</p>
                <p>Cant promise i will still continue the development after i actually make so it can be considered as finished. But ill try to add stuff from time to time.</p>
            </div>
            <p>placeholder img -></p>
            <div style="width: 100px; border-left: 3px solid #8d8296;"><img src="../../public/oneko1.png"></div>

        </ContentBox>
        <ContentBox>
            <div class="yap"><h2>Why this exact name?</h2>
                <p>I dont know theres no name yet so i cant tell. Maybe ill come up with something or maybe it will just be my username. Time will tell</p>
            </div>
            <div style="border-left: 3px solid #8d8296;">
                <ul>
                    <h3>Update history</h3>
                    <li>October 14 - The idea was born</li>
                </ul>
                
            </div>
        </ContentBox>
        <ContentBox>mrrprprprprppr</ContentBox>
    </div>
</BasedLayout>
<script>
    import '../scripts/oneko.ts'
</script>