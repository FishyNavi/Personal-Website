---
const { name, message, date } = Astro.props;
let d = new Date(date);
const fdate = `at ${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")} on ${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}.${d.getFullYear()}`;
---

<div class="message">
    <strong class="name">{name}</strong> said:
    <p class="message-body">{message}</p>
    <var class="date">Sent {fdate}</var>
</div>
<style>
    .message {
        background-color: #24192d;
        padding: 0.5rem;
    }
</style>
