---
import { db } from "../db";
import { messages } from "../db/schema";
---

<div class="message-form">
    <div>
        <strong>Username: </strong>
        <input
            type="text"
            id="name-input"
            maxlength="50"
            placeholder="Nyan.."
        />
    </div>
    <strong>Message:</strong>
    <div>
        <textarea id="message-input" maxlength="500" />
    </div>

    <button id="send-button">Send</button>
</div>

<script>
    import { actions } from "astro:actions";
    const button = document.querySelector("button");
    const name_input = document.getElementById(
        "name-input",
    ) as HTMLInputElement;
    const message_input = document.getElementById(
        "message-input",
    ) as HTMLInputElement;
    button?.addEventListener("click", async () => {
        const name = name_input?.value.trim() ?? "";
        const message = message_input?.value.trim() ?? "";

        const { data, error } = await actions.sendEntry({
            name,
            message,
        });
        if (error?.code === "NOT_ACCEPTABLE") {
            alert(error?.message);
        } else if (error) return;

        if (data) {
            window.dispatchEvent(
                new CustomEvent("add_message", {
                    detail: {
                        name: data.name,
                        message: data.message,
                        date: data.date,
                    },
                }),
            );
        }
    });
</script>
<style></style>
<style>
    #message-input {
        width: 70%;
        height: 120px;
        font-family: inherit;
        resize: none;
        padding: 5px;
    }
    input:focus,
    textarea:focus {
        outline: none;
        border-color: #bd96de;
    }
    input,
    textarea {
        background-color: #24192d;
        color: #bd96de;
        border-radius: 5px;
    }
</style>
